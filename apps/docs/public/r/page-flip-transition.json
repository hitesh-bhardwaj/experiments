{
  "name": "page-flip-transition",
  "type": "registry:component",
  "title": "Page Flip Transition",
  "description": "Angular full-screen route wipe with a folding panel and staggered indicator bars",
  "dependencies": [
    "gsap",
    "next-transition-router"
  ],
  "registryDependencies": [],
  "exportName": "FlipTransition",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion route fallback with short opacity fades.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "duration",
      "type": "number",
      "default": 0.9,
      "description": "Page flip duration.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0.2,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "bgColor",
      "type": "string",
      "default": "#ff5f00",
      "description": "Overlay background color.",
      "remixer": {
        "control": "color",
        "group": "surface",
        "groupTitle": "Surface"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "timing",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/page-flip-transition/index.tsx"
    }
  ]
}