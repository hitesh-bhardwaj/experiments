{
  "name": "radial-slice-transition",
  "type": "registry:component",
  "title": "Radial Slice Transition",
  "description": "Conic-gradient page transition that sweeps a pie-slice mask across the viewport using GSAP, revealing and hiding pages with a smooth rotational wipe",
  "dependencies": [
    "gsap",
    "next-transition-router"
  ],
  "registryDependencies": [],
  "exportName": "RadialSliceTransition",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion route fallback with short opacity fades.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "duration",
      "type": "number",
      "default": 4,
      "description": "Total duration of the radial slice transition.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.75,
        "max": 8,
        "step": 0.05
      }
    },
    {
      "name": "color",
      "type": "string",
      "default": "#0F2854",
      "description": "Radial slice overlay color.",
      "remixer": {
        "control": "color",
        "group": "surface",
        "groupTitle": "Surface"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/radial-slice-transition/index.tsx"
    }
  ]
}