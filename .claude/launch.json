{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vault-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "vault-main",
        "run",
        "dev",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "vault-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "vault-main",
        "run",
        "start",
        "--",
        "-p",
        "3000"
      ],
      "port": 3000
    }
  ]
}