{
  "name": "lines-loader",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Lines Loader",
  "description": "Two GSAP-powered line loaders: staggered horizontal lines wipe from dark to light (Option 1), or a diamond cone that peels away to reveal a hero message (Option 2)",
  "category": "loaders",
  "dependencies": [
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/lines-loader",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "LinesLoader",
  "exportKind": "default",
  "importPath": "@/components/effects/lines-loader",
  "target": "src/components/effects/lines-loader",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/lines-loader/index.tsx"
    },
    {
      "path": "LinesLoading.tsx",
      "target": "src/components/effects/lines-loader/LinesLoading.tsx"
    },
    {
      "path": "CenterLinesLoading.tsx",
      "target": "src/components/effects/lines-loader/CenterLinesLoading.tsx"
    },
    {
      "path": "utils.ts",
      "target": "src/components/effects/lines-loader/utils.ts"
    }
  ],
  "props": [
    {
      "name": "duration",
      "type": "number",
      "default": 1,
      "description": "Overall timeline duration multiplier.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.25,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "lineHeight",
      "type": "number",
      "default": 1,
      "description": "Rendered height of each loader line in pixels.",
      "remixer": {
        "control": "range",
        "group": "lines",
        "groupTitle": "Lines",
        "min": 1,
        "max": 12,
        "step": 1
      }
    },
    {
      "name": "darkLineColor",
      "type": "color",
      "default": "#ffffff",
      "description": "Line color on the dark loader layer.",
      "remixer": {
        "control": "color",
        "group": "lines",
        "groupTitle": "Lines"
      }
    },
    {
      "name": "lightLineColor",
      "type": "color",
      "default": "#000000",
      "description": "Line color on the light reveal layer.",
      "remixer": {
        "control": "color",
        "group": "lines",
        "groupTitle": "Lines"
      }
    },
    {
      "name": "fadeOutDuration",
      "type": "number",
      "default": 0.5,
      "description": "Duration of the line fade-out phases.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 3,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support: hero text fades in as a single block instead of a per-letter stagger",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ]
}
