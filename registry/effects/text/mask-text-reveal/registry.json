{
  "name": "mask-text-reveal",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-30",
      "summary": "Added reduced motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Mask Text Reveal",
  "description": "Text reveal animation with gradient mask effect that sweeps across each line on scroll",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/mask-text-reveal",
  "tier": "pro",
  "exportName": "MaskTextReveal",
  "exportKind": "default",
  "main": "index.tsx",
  "props": [
    {
      "name": "animateOnScroll",
      "type": "boolean",
      "default": true,
      "description": "Runs reveal on scroll.",
      "remixer": {
        "enabled": false,
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.2,
      "description": "Delay between animated lines.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 1,
        "step": 0.05
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 5.5,
      "description": "Mask reveal duration.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0.5,
        "max": 8,
        "step": 0.1
      }
    },
    {
      "name": "delay",
      "type": "number",
      "default": 0,
      "description": "Animation delay.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Links the reveal to scroll progress.",
      "remixer": {
        "enabled": false,
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "behavior",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/mask-text-reveal/index.tsx"
    }
  ]
}
