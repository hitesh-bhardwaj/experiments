{
  "name": "perspective-text-reveal",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-30",
      "summary": "Added reduced motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Perspective Text Reveal",
  "description": "3D perspective rotation text reveal with lines flipping into view on scroll",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/perspective-text-reveal",
  "tier": "pro",
  "exportName": "PerspectiveTextReveal",
  "exportKind": "default",
  "main": "index.tsx",
  "props": [
    {
      "name": "animateOnScroll",
      "type": "boolean",
      "default": true,
      "description": "Runs reveal on scroll.",
      "remixer": {
        "enabled": false,
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "delay",
      "type": "number",
      "default": 0,
      "description": "Animation delay in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.8,
      "description": "Line reveal duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0.1,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.08,
      "description": "Delay between revealed lines.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 0.5,
        "step": 0.01
      }
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Links the reveal to scroll progress.",
      "remixer": {
        "enabled": false,
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "startOpacity",
      "type": "number",
      "default": 0,
      "description": "Opacity the text starts from before it reveals.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 1,
        "step": 0.05
      }
    },
    {
      "name": "direction",
      "type": "string",
      "default": "top",
      "description": "Side the text swings in from.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "value": "top",
            "label": "Top"
          },
          {
            "value": "bottom",
            "label": "Bottom"
          }
        ]
      }
    },
    {
      "name": "splitBy",
      "type": "string",
      "default": "lines",
      "description": "Animate per character, per word, or per line.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "value": "chars",
            "label": "Characters"
          },
          {
            "value": "words",
            "label": "Words"
          },
          {
            "value": "lines",
            "label": "Lines"
          }
        ]
      }
    },
    {
      "name": "rotation",
      "type": "number",
      "default": 70,
      "description": "Starting tilt in degrees; its sign follows the direction.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 90,
        "step": 1
      }
    },
    {
      "name": "ease",
      "type": "string",
      "default": "power3.out",
      "description": "GSAP ease for the reveal.",
      "remixer": {
        "control": "select",
        "group": "timing",
        "groupTitle": "Timing",
        "options": [
          {
            "value": "none",
            "label": "none (linear)"
          },
          {
            "value": "power1.in",
            "label": "power1.in"
          },
          {
            "value": "power1.out",
            "label": "power1.out"
          },
          {
            "value": "power1.inOut",
            "label": "power1.inOut"
          },
          {
            "value": "power2.in",
            "label": "power2.in"
          },
          {
            "value": "power2.out",
            "label": "power2.out"
          },
          {
            "value": "power2.inOut",
            "label": "power2.inOut"
          },
          {
            "value": "power3.in",
            "label": "power3.in"
          },
          {
            "value": "power3.out",
            "label": "power3.out"
          },
          {
            "value": "power3.inOut",
            "label": "power3.inOut"
          },
          {
            "value": "power4.in",
            "label": "power4.in"
          },
          {
            "value": "power4.out",
            "label": "power4.out"
          },
          {
            "value": "power4.inOut",
            "label": "power4.inOut"
          },
          {
            "value": "expo.in",
            "label": "expo.in"
          },
          {
            "value": "expo.out",
            "label": "expo.out"
          },
          {
            "value": "expo.inOut",
            "label": "expo.inOut"
          },
          {
            "value": "sine.in",
            "label": "sine.in"
          },
          {
            "value": "sine.out",
            "label": "sine.out"
          },
          {
            "value": "sine.inOut",
            "label": "sine.inOut"
          },
          {
            "value": "circ.in",
            "label": "circ.in"
          },
          {
            "value": "circ.out",
            "label": "circ.out"
          },
          {
            "value": "circ.inOut",
            "label": "circ.inOut"
          },
          {
            "value": "back.in",
            "label": "back.in"
          },
          {
            "value": "back.out",
            "label": "back.out"
          },
          {
            "value": "back.inOut",
            "label": "back.inOut"
          },
          {
            "value": "elastic.in",
            "label": "elastic.in"
          },
          {
            "value": "elastic.out",
            "label": "elastic.out"
          },
          {
            "value": "elastic.inOut",
            "label": "elastic.inOut"
          },
          {
            "value": "bounce.in",
            "label": "bounce.in"
          },
          {
            "value": "bounce.out",
            "label": "bounce.out"
          },
          {
            "value": "bounce.inOut",
            "label": "bounce.inOut"
          }
        ]
      }
    },
    {
      "name": "perspective",
      "type": "number",
      "default": 800,
      "description": "Perspective distance in px - lower values give a stronger 3D effect.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 200,
        "max": 2000,
        "step": 10
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "timing",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/perspective-text-reveal/index.tsx"
    }
  ],
  "importPath": "@/components/effects/perspective-text-reveal",
  "target": "src/components/effects/perspective-text-reveal"
}
