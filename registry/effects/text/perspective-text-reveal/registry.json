{
  "name": "perspective-text-reveal",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-30",
      "summary": "Added reduced motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Perspective Text Reveal",
  "description": "3D perspective rotation text reveal with lines flipping into view on scroll",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/perspective-text-reveal",
  "tier": "pro",
  "exportName": "PerspectiveTextReveal",
  "exportKind": "default",
  "main": "index.tsx",
  "props": [
    {
      "name": "animateOnScroll",
      "type": "boolean",
      "default": true,
      "description": "Runs reveal on scroll.",
      "remixer": {
        "enabled": false,
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "delay",
      "type": "number",
      "default": 0,
      "description": "Animation delay in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.8,
      "description": "Line reveal duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0.1,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.08,
      "description": "Delay between revealed lines.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 0.5,
        "step": 0.01
      }
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Links the reveal to scroll progress.",
      "remixer": {
        "enabled": false,
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "timing",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/perspective-text-reveal/index.tsx"
    }
  ]
}
