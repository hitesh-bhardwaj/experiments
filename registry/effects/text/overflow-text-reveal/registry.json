{
  "name": "overflow-text-reveal",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion overflow reveal.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Overflow Text Reveal",
  "description": "Text lines slide up from hidden overflow with smooth stagger animation on scroll",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/overflow-text-reveal",
  "tier": "pro",
  "exportName": "OverflowTextReveal",
  "exportKind": "default",
  "main": "index.tsx",
  "props": [
    { "name": "animateOnScroll", "type": "boolean", "default": true, "description": "Runs the reveal when scrolled into view.", "remixer": { "enabled": false, "control": "checkbox", "group": "behavior", "groupTitle": "Behavior" } },
    { "name": "delay", "type": "number", "default": 0, "description": "Animation delay.", "remixer": { "control": "range", "group": "timing", "groupTitle": "Timing", "min": 0, "max": 2, "step": 0.05 } },
    { "name": "scrub", "type": "boolean", "default": false, "description": "Links the animation to scroll progress.", "remixer": { "enabled": false, "control": "checkbox", "group": "behavior", "groupTitle": "Behavior" } },
    { "name": "direction", "type": "string", "default": "bottom", "description": "Reveal direction.", "remixer": { "control": "select", "group": "style", "groupTitle": "Style", "options": [ { "value": "bottom", "label": "Bottom" }, { "value": "top", "label": "Top" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] } }
  ],
  "remixer": { "enabled": true, "defaultOpenGroupId": "behavior", "layout": { "buttonClassName": "right-4! top-25!", "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!" }, "copyCode": { "includeOnlyPublicProps": true } },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/overflow-text-reveal/index.tsx"
    }
  ]
}
