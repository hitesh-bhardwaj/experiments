{
  "name": "text-fill-animation",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-07-29",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Text Fill Animation",
  "description": "Scroll-synced text color fill animation with customizable color sweep effect",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/text-fill-animation",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "TextFillAnimation",
  "exportKind": "default",
  "importPath": "@/components/effects/text-fill-animation",
  "target": "src/components/effects/text-fill-animation",
  "props": [
    {
      "name": "text",
      "type": "string",
      "default": "Design systems should feel effortless, not like you're fighting your own components every time you build.",
      "description": "Text filled on scroll."
    },
    {
      "name": "textColor",
      "type": "string",
      "default": "#111111",
      "description": "Final text color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "primaryColor",
      "type": "string",
      "default": "#ff6b00",
      "description": "Highlight color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "dimColor",
      "type": "string",
      "default": "#AAAAAA",
      "description": "Initial dimmed text color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#F0EFE9",
      "description": "Section background color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.4,
      "description": "Character fill animation duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 1.5,
        "step": 0.05
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.05,
      "description": "Delay offset between each animated character.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.2,
        "step": 0.005
      }
    },
    {
      "name": "fillWidth",
      "type": "number",
      "default": 1,
      "description": "Width of the color fill sweep band applied to each character.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.3,
        "max": 3,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "colors",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/text-fill-animation/index.tsx"
    }
  ]
}
