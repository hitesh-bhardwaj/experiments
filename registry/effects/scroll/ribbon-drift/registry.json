{
  "name": "ribbon-drift",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Ribbon Drift",
  "description": "Scroll-driven ribbon gallery where image strips drift horizontally at alternating speeds, revealing project names with GSAP SplitText on scroll.",
  "category": "scroll",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/ribbon-drift",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "RibbonDrift",
  "exportKind": "default",
  "importPath": "@/components/effects/ribbon-drift",
  "target": "src/components/effects/ribbon-drift",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/ribbon-drift/index.tsx"
    }
  ],
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-30",
      "summary": "Added reduced-motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-22",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "driftSpeed",
      "type": "number",
      "description": "Speed of the ribbon drift.",
      "default": 1,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "blockSize",
      "type": "number",
      "description": "Size of the card blocks that hold the images in the ribbon strips.",
      "default": 1,
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0.5,
        "max": 2,
        "step": 0.05
      },
      "label": "Block Size"
    },
    {
      "name": "showNames",
      "type": "boolean",
      "description": "Shows project names on hover. When off, the card hover effect is disabled too.",
      "default": true,
      "remixer": {
        "control": "checkbox",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "textColor",
      "type": "color",
      "description": "Color of the project name revealed inside a card block on hover.",
      "default": "#ffffff",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style",
        "visibleWhen": {
          "name": "showNames",
          "eq": true
        }
      }
    },
    {
      "name": "borderWidth",
      "type": "number",
      "default": 0,
      "description": "Border width of the card blocks in pixels.",
      "remixer": {
        "control": "range",
        "min": 0,
        "max": 12,
        "step": 1,
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "borderColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Border color of the card blocks.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "borderRadius",
      "type": "number",
      "default": 0,
      "description": "Corner radius of the card blocks in pixels.",
      "remixer": {
        "control": "range",
        "min": 0,
        "max": 80,
        "step": 1,
        "group": "style",
        "groupTitle": "Style"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
