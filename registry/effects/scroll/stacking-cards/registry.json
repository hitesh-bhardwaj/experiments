{
  "name": "stacking-cards",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-22",
      "summary": "Added reduced motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-21",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Stacking Cards",
  "description": "Full-screen card sequence that stacks, tilts, and reveals the next scene on scroll",
  "category": "scroll",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/stacking-cards",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "StackingCards",
  "exportKind": "default",
  "importPath": "@/components/effects/stacking-cards",
  "target": "src/components/effects/stacking-cards",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/stacking-cards/index.tsx"
    }
  ],
  "props": [
    {
      "name": "imageZoomEnabled",
      "type": "boolean",
      "default": true,
      "description": "Enables the image zoom-in effect during card reveals.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion"
      }
    },
    {
      "name": "tiltEnabled",
      "type": "boolean",
      "default": true,
      "description": "Enables the outgoing card tilt, scale, and rotateX treatment.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion"
      }
    },
    {
      "name": "cardCornerRadius",
      "type": "number",
      "default": 48,
      "description": "Corner radius in pixels applied to the cards as they stack (not the images).",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 96,
        "step": 1
      }
    },
    {
      "name": "stackPerspective",
      "type": "number",
      "default": 1200,
      "description": "Perspective depth for the tilt. Only applies while tilt is enabled.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 200,
        "max": 2400,
        "step": 10,
        "visibleWhen": {
          "name": "tiltEnabled",
          "eq": true
        }
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": false,
    "defaultOpenGroupId": "motion",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    }
  }
}
