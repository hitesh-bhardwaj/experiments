{
  "name": "parallax-image-animation",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: translateY parallax shift and scale range are reduced to 25% strength instead of full motion",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Parallax Image",
  "description": "Image with smooth parallax scrolling effect using GSAP ScrollTrigger",
  "category": "scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/parallax-image-animation",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "ParallaxImageAnimation",
  "exportKind": "default",
  "importPath": "@/components/effects/parallax-image-animation",
  "target": "src/components/effects/parallax-image-animation",
  "props": [
    {
      "name": "translateY",
      "type": "string",
      "default": "30%",
      "description": "Vertical parallax travel.",
      "remixer": {
        "control": "text",
        "group": "motion",
        "groupTitle": "Motion"
      }
    },
    {
      "name": "scrub",
      "type": "boolean | number",
      "default": true,
      "description": "Links animation progress to scroll. Accepts true or a numeric scrub delay.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion"
      }
    },
    {
      "name": "enableScale",
      "type": "boolean",
      "default": false,
      "description": "Enables scale animation while scrolling.",
      "remixer": {
        "control": "checkbox",
        "group": "scale",
        "groupTitle": "Scale"
      }
    },
    {
      "name": "scaleFrom",
      "type": "number",
      "default": 1.6,
      "description": "Initial image scale.",
      "remixer": {
        "control": "range",
        "group": "scale",
        "groupTitle": "Scale",
        "min": 1,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "scaleTo",
      "type": "number",
      "default": 1.2,
      "description": "Final image scale.",
      "remixer": {
        "control": "range",
        "group": "scale",
        "groupTitle": "Scale",
        "min": 1,
        "max": 3,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/parallax-image-animation/index.tsx"
    }
  ]
}
