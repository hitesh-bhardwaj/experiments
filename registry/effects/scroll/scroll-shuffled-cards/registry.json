{
  "name": "scroll-shuffled-cards",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: cards stay at their resting position with 0 rotation instead of shuffling; the container's overall scroll slide is unaffected",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Scroll Shuffled Cards",
  "description": "Pinned scroll section that drifts a shuffled stack of editorial cards across the viewport",
  "category": "scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/scroll-shuffled-cards",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "ScrollShuffledCards",
  "exportKind": "default",
  "importPath": "@/components/effects/scroll-shuffled-cards",
  "target": "src/components/effects/scroll-shuffled-cards",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/scroll-shuffled-cards/index.tsx"
    },
    {
      "path": "ScrollShuffledCardsComp.tsx",
      "target": "src/components/effects/scroll-shuffled-cards/ScrollShuffledCardsComp.tsx"
    },
    {
      "path": "card.tsx",
      "target": "src/components/effects/scroll-shuffled-cards/card.tsx"
    }
  ],
  "props": [
    {
      "name": "background",
      "type": "color",
      "default": "#FFFBEB",
      "description": "Background color of the section.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "cardsGap",
      "type": "number",
      "default": 6,
      "description": "Spacing between cards, in vw.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 20,
        "step": 0.5
      }
    },
    {
      "name": "sectionHeight",
      "type": "number",
      "default": 400,
      "description": "Total scroll-track height (vh) \u2014 controls how much scrolling the shuffle takes.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 100,
        "max": 800,
        "step": 10
      }
    },
    {
      "name": "shuffleIntensity",
      "type": "number",
      "default": 1,
      "description": "Multiplier on how far and how much each card drifts/rotates during the shuffle.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
