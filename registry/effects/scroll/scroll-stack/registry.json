{
  "name": "scroll-stack",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added prefers-reduced-motion support: cards no longer scale down while stacking (stays at scale 1), remaining crossfade keeps a linear (none) ease",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Scroll Stack",
  "description": "Successive content cards that hand off focus and fade as the next section enters",
  "category": "scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/scroll-stack",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "ScrollStack",
  "exportKind": "default",
  "importPath": "@/components/effects/scroll-stack",
  "target": "src/components/effects/scroll-stack",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/scroll-stack/index.tsx"
    },
    {
      "path": "ScrollStackComp.tsx",
      "target": "src/components/effects/scroll-stack/ScrollStackComp.tsx"
    }
  ],
  "props": [
    {
      "name": "sectionBgColor",
      "type": "color",
      "default": "#ffffff",
      "description": "Background color of the section.",
      "remixer": { "control": "color", "group": "style", "groupTitle": "Style" }
    },
    {
      "name": "cardRadius",
      "type": "number",
      "default": 45,
      "description": "Corner rounding on each card, in px (desktop only - tablet/mobile keep their own responsive radius).",
      "remixer": { "control": "range", "group": "style", "groupTitle": "Style", "min": 0, "max": 100, "step": 1 }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": { "includeOnlyPublicProps": true }
  }
}
