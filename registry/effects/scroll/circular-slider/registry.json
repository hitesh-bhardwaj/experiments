      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 240,
        "max": 520,
        "step": 4
      }
    },
    {
      "name": "cardColorCount",
      "type": "number",
      "default": 5,
      "description": "How many card background colors to cycle through the cards (1 to the number of cards).",
      "remixer": {
        "control": "range",
        "group": "cardColors",
        "groupTitle": "Card Colors",
        "min": 1,
        "max": 6,
        "step": 1
      }
