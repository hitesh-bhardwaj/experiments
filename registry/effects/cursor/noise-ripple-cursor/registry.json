{
  "name": "noise-ripple-cursor",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-23",
      "summary": "Added reduced-motion support and removed debug logging on pointer events.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Noise Ripple Cursor",
  "description": "Interactive shader overlay that distorts and dithers an image with fluid cursor ripples",
  "category": "cursor",
  "dependencies": [
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/noise-ripple-cursor",
  "coverImage": "noise-ripple-cursor",
  "videoUrl": "noise-ripple-cursor",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "NoiseRippleCursor",
  "exportKind": "default",
  "importPath": "@/components/effects/noise-ripple-cursor",
  "target": "src/components/effects/noise-ripple-cursor",
  "props": [
    {
      "name": "overlayColor",
      "type": "color",
      "default": "#1825AA",
      "description": "Overlay and ripple shader color.",
      "remixer": {
        "control": "color",
        "group": "surface",
        "groupTitle": "Surface"
      }
    },
    {
      "name": "pixelSize",
      "type": "number",
      "default": 0.5,
      "description": "Pixel block size used by the dither shader.",
      "remixer": {
        "control": "range",
        "group": "shader",
        "groupTitle": "Shader",
        "min": 0.1,
        "max": 8,
        "step": 0.1
      }
    },
    {
      "name": "lerp",
      "type": "number",
      "default": 0.2,
      "description": "Mouse smoothing amount for the ripple source.",
      "remixer": {
        "control": "range",
        "group": "shader",
        "groupTitle": "Shader",
        "min": 0.01,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "name": "distortion",
      "type": "number",
      "default": 0.5,
      "description": "Strength of the image UV distortion.",
      "remixer": {
        "control": "range",
        "group": "shader",
        "groupTitle": "Shader",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "radius",
      "type": "number",
      "default": 0.08,
      "description": "Radius of the cursor ripple influence.",
      "remixer": {
        "control": "range",
        "group": "shader",
        "groupTitle": "Shader",
        "min": 0.01,
        "max": 0.3,
        "step": 0.01
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "surface",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/noise-ripple-cursor/index.tsx"
    },
    {
      "path": "2dCanvasTracker.tsx",
      "target": "src/components/effects/noise-ripple-cursor/2dCanvasTracker.ts"
    },
    {
      "path": "createSuspendedRaf.ts",
      "target": "src/components/effects/noise-ripple-cursor/createSuspendedRaf.ts"
    }
  ]
}
