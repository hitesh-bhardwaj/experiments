{
  "name": "animated-form",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Animated Form",
  "description": "Config-driven contact form with validation for text, phone, select, textarea, and checkbox fields",
  "category": "components",
  "dependencies": [
    "zod"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-form",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "AnimatedForm",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-form",
  "target": "src/components/effects/animated-form",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/animated-form/index.tsx"
    },
    {
      "path": "Button.tsx",
      "target": "src/components/effects/animated-form/Button.tsx"
    },
    {
      "path": "Checkbox.tsx",
      "target": "src/components/effects/animated-form/Checkbox.tsx"
    },
    {
      "path": "ContactForm.tsx",
      "target": "src/components/effects/animated-form/ContactForm.tsx"
    },
    {
      "path": "Input.tsx",
      "target": "src/components/effects/animated-form/Input.tsx"
    },
    {
      "path": "PhoneInput.tsx",
      "target": "src/components/effects/animated-form/PhoneInput.tsx"
    },
    {
      "path": "Select.tsx",
      "target": "src/components/effects/animated-form/Select.tsx"
    },
    {
      "path": "Textarea.tsx",
      "target": "src/components/effects/animated-form/Textarea.tsx"
    }
  ],
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-30",
      "summary": "Added configurable color, border-radius, and duration controls.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-23",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "accentColor",
      "type": "color",
      "default": "#111111",
      "description": "Accent color for focus states, checkbox checks, and the submit button.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "backgroundColor",
      "type": "color",
      "default": "#ffffff",
      "description": "Page background color around the form.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "textColor",
      "type": "color",
      "default": "#111111",
      "description": "Text color for the form heading and field labels.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "inputBackgroundColor",
      "type": "color",
      "default": "#ffffff",
      "description": "Background color for inputs, textarea, and select controls.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "fieldBorderColor",
      "type": "color",
      "default": "#e5e7eb",
      "description": "Default border color for form controls.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "inputRoundedness",
      "type": "number",
      "default": 28,
      "description": "Border radius for inputs and the submit button in pixels.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 48,
        "step": 1
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.3,
      "description": "Transition duration for control focus and button effects in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.05,
        "max": 2,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
