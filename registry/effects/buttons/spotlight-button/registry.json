{
  "name": "spotlight-button",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-09-16",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Spotlight Button",
  "description": "Animated orbiting halo button with a glowing border and hover spotlight.",
  "category": "buttons",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/spotlight-button",
  "tier": "pro",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "SpotlightButton",
  "exportKind": "default",
  "importPath": "@/components/effects/spotlight-button",
  "target": "src/components/effects/spotlight-button",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/spotlight-button/index.tsx"
    }
  ],
  "props": [
    {
      "name": "haloColor",
      "type": "string",
      "default": "#ff5f00",
      "description": "Main color of the orbiting halo.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "haloCoreColor",
      "type": "string",
      "default": "#ff9253",
      "description": "Bright core color on hover and keyboard focus.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "spotlightIntensity",
      "type": "number",
      "default": 1,
      "description": "Strength of the border spotlight and glow.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 1,
        "step": 0.05
      }
    },
    {
      "name": "orbitDuration",
      "type": "number",
      "default": 3,
      "description": "Seconds for one full orbit.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 1,
        "max": 10,
        "step": 0.1
      }
    },
    {
      "name": "settleDuration",
      "type": "number",
      "default": 0.8,
      "description": "Hover and focus transition duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "haloWidth",
      "type": "number",
      "default": 5,
      "description": "Width of each halo gradient segment as a percentage of the sweep.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 1,
        "max": 20,
        "step": 1
      }
    },
    {
      "name": "size",
      "type": "\"sm\" | \"md\" | \"lg\"",
      "default": "md",
      "description": "Button size: small, medium, or large.",
      "remixer": {
        "enabled": false
      }
    },
    {
      "name": "overlayColor",
      "type": "string",
      "default": "bg-black/30",
      "description": "Tailwind class for the tint layered over the inner spotlight.",
      "remixer": {
        "enabled": false
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "style",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
