{
  "name": "sweep-lift-transition",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-08-12",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Sweep Lift Transition",
  "description": "The outgoing page lifts and fades into the background while the incoming page sweeps up from the bottom via a clip-path reveal.",
  "category": "transitions",
  "dependencies": [
    "gsap",
    "next-transition-router"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/sweep-lift-transition",
  "tier": "pro",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "SweepLiftTransition",
  "exportKind": "default",
  "importPath": "@/components/effects/sweep-lift-transition",
  "target": "src/components/effects/sweep-lift-transition",
  "props": [
    {
      "name": "bgColor",
      "type": "string",
      "default": "#111111",
      "description": "Background color behind the transitioning pages.",
      "remixer": {
        "control": "color",
        "group": "surface",
        "groupTitle": "Surface"
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 1.3,
      "description": "Duration used by both the outgoing lift and incoming sweep reveal.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.2,
        "max": 2.5,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/sweep-lift-transition/index.tsx"
    }
  ]
}
