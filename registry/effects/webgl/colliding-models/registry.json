{
  "name": "colliding-models",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-30",
      "summary": "Added a reduced-motion notice and wired connectorCount, gravity, modelScale, and backgroundColor into the live scene.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Colliding Models",
  "description": "Physics-driven colliding 3D connectors with transmission material and postprocessing, built with R3F + Rapier.",
  "category": "webgl",
  "dependencies": [
    "@react-three/drei",
    "@react-three/fiber",
    "@react-three/postprocessing",
    "@react-three/rapier",
    "maath",
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/colliding-models",
  "coverImage": "colliding-models",
  "videoUrl": "colliding-models.mp4",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "CollidingModels",
  "exportKind": "default",
  "importPath": "@/components/effects/colliding-models",
  "target": "src/components/effects/colliding-models",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/colliding-models/index.tsx"
    }
  ],
  "props": [
    {
      "name": "geometry",
      "type": "string",
      "default": "model",
      "description": "Shape of the colliding pieces: the Hyperiux logo model or a built-in geometry."
    },
    {
      "name": "connectorCount",
      "type": "number",
      "default": 8,
      "description": "Number of connecting shapes or joints.",
      "suggested": true
    },
    {
      "name": "modelScale",
      "type": "number",
      "default": 1,
      "description": "Scale applied to the 3D model.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#141518",
      "description": "Canvas background color.",
      "suggested": true
    },
    {
      "name": "returnToPosition",
      "type": "boolean",
      "default": true,
      "description": "Pull pieces back to the cluster after the cursor knocks them away."
    },
    {
      "name": "returnSpeed",
      "type": "number",
      "default": 1,
      "description": "How quickly knocked pieces come back to the cluster."
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "geometry",
        "label": "Geometry",
        "type": "select",
        "group": "controls",
        "copyable": true,
        "options": [
          {
            "value": "model",
            "label": "Hyperiux Model"
          },
          {
            "value": "sphere",
            "label": "Sphere"
          },
          {
            "value": "torus",
            "label": "Torus"
          },
          {
            "value": "icosahedron",
            "label": "Icosahedron"
          }
        ]
      },
      {
        "name": "connectorCount",
        "label": "Connector Count",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 24,
        "step": 1
      },
      {
        "name": "modelScale",
        "label": "Model Scale",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 3,
        "step": 0.05
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "returnToPosition",
        "label": "Return To Position",
        "type": "toggle",
        "group": "controls",
        "copyable": true
      },
      {
        "name": "returnSpeed",
        "label": "Return Speed",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0.1,
        "max": 5,
        "step": 0.05,
        "visibleWhen": {
          "name": "returnToPosition",
          "eq": true
        }
      }
    ]
  }
}
