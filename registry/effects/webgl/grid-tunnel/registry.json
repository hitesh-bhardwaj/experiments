{
  "name": "grid-tunnel",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Grid Tunnel",
  "description": "Infinite 3D image tunnel built with React Three Fiber, procedural wireframe chunks, and inertial wheel-driven camera motion.",
  "category": "webgl",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/drei",
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/grid-tunnel",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "GridTunnel",
  "exportKind": "default",
  "importPath": "@/components/effects/grid-tunnel",
  "target": "src/components/effects/grid-tunnel",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/grid-tunnel/index.tsx"
    },
    {
      "path": "GridTunnelComp.tsx",
      "target": "src/components/effects/grid-tunnel/GridTunnelComp.tsx"
    },
    {
      "path": "createSuspendedRaf.ts",
      "target": "src/components/effects/grid-tunnel/createSuspendedRaf.ts"
    }
  ],
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-24",
      "summary": "Added reduced-motion support and hardened camera-frame timing so a long tab-hidden pause no longer displaces the camera on resume.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "gridSize",
      "type": "number",
      "default": 24,
      "description": "Tunnel grid density.",
      "suggested": true
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Scroll and touch travel speed.",
      "suggested": true
    },
    {
      "name": "depth",
      "type": "number",
      "default": 1000,
      "description": "Visible tunnel fog depth.",
      "suggested": true
    },
    {
      "name": "lineColor",
      "type": "string",
      "default": "#9ca3af",
      "description": "Grid line color.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Tunnel background color.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "content",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "gridSize",
        "label": "Grid Size",
        "type": "range",
        "group": "content",
        "copyable": true,
        "min": 6,
        "max": 48,
        "step": 1
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "depth",
        "label": "Depth",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 100,
        "max": 3000,
        "step": 10
      },
      {
        "name": "lineColor",
        "label": "Line Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      }
    ]
  }
}
