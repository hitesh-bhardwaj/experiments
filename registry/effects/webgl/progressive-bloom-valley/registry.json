{
  "name": "progressive-bloom-valley",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Progressive Bloom Valley",
  "description": "WebGL particle valley flythrough with scroll-driven camera path, proximity bloom, magnetic flower interaction, film grain, and edge blur post-processing",
  "category": "webgl",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/drei",
    "@react-three/postprocessing",
    "three",
    "postprocessing",
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/progressive-bloom-valley",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "ProgressiveBloomValley",
  "exportKind": "default",
  "importPath": "@/components/effects/progressive-bloom-valley",
  "target": "src/components/effects/progressive-bloom-valley",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/progressive-bloom-valley/index.tsx"
