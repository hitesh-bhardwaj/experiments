    },
    {
      "path": "ExperienceComp.tsx",
      "target": "src/components/effects/progressive-bloom-valley/ExperienceComp.tsx"
    },
    {
      "path": "FilmGrainEffect.tsx",
      "target": "src/components/effects/progressive-bloom-valley/FilmGrainEffect.tsx"
    },
    {
      "path": "Flower.tsx",
      "target": "src/components/effects/progressive-bloom-valley/Flower.tsx"
