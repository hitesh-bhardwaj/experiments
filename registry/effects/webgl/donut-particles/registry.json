{
  "name": "donut-particles",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Donut Particles",
  "description": "Interactive 3D donut particle field built with React Three Fiber. Includes cursor-driven flow, inertial motion, and a fullscreen canvas wrapper.",
  "category": "webgl",
  "dependencies": [
    "@react-three/fiber",
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/donut-particles",
  "coverImage": "donut-particles",
  "videoUrl": "donut-particles.mp4",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "DonutParticles",
  "exportKind": "default",
  "importPath": "@/components/effects/donut-particles",
  "target": "src/components/effects/donut-particles",
  "props": [
    {
      "name": "particleSize",
      "type": "number",
      "default": 1,
      "description": "Scale multiplier applied to every particle's rendered size."
    },
    {
      "name": "donutScale",
      "type": "number",
      "default": 3.5,
      "description": "Scale applied to the particle donut."
    },
    {
      "name": "particleColor",
      "type": "color",
      "default": "#9973ff",
      "description": "Base color used for the particle glow cycle."
    },
    {
      "name": "mouseInteraction",
      "type": "boolean",
      "default": true,
      "description": "Enables cursor-driven particle flow on desktop viewports."
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Playback speed multiplier for rotation and particle motion."
    },
    {
      "name": "intensity",
      "type": "number",
      "default": 1,
      "description": "Strength multiplier for particle glow and cursor interaction force."
    },
    {
      "name": "donutPosition",
      "type": "array",
      "default": [
        0,
        0,
        0
      ],
      "description": "XYZ position of the particle donut."
    },
    {
      "name": "donutRotation",
      "type": "array",
      "default": [
        -1.0471975512,
        0.7853981634,
        0
      ],
      "description": "XYZ rotation of the particle donut in radians."
    },
    {
      "name": "cameraPosition",
      "type": "array",
      "default": [
        2,
        4,
        6
      ],
      "description": "XYZ camera position for the WebGL scene."
    },
    {
      "name": "dpr",
      "type": "array",
      "default": [
        1,
        2
      ],
      "description": "Device pixel ratio range used by the canvas."
    },
    {
      "name": "morphDuration",
      "type": "number",
      "default": 1.5,
      "description": "Seconds for scattered particles to settle back into the donut."
    },
    {
      "name": "demorphIntensity",
      "type": "number",
      "default": 1,
      "description": "How strongly the cursor pulls particles out of the donut shape."
    },
    {
      "name": "rotationSpeed",
      "type": "number",
      "default": 1,
      "description": "Donut spin speed multiplier."
    },
    {
      "name": "tiltX",
      "type": "number",
      "default": -60,
      "description": "Donut tilt around the X axis in degrees."
    },
    {
      "name": "tiltY",
      "type": "number",
      "default": 45,
      "description": "Donut tilt around the Y axis in degrees."
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "particles",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "particleSize",
        "label": "Particle Size",
        "type": "range",
        "group": "particles",
        "min": 0.3,
        "max": 3,
        "step": 0.1
      },
      {
        "name": "donutScale",
        "label": "Donut Scale",
        "type": "range",
        "group": "particles",
        "min": 1,
        "max": 7,
        "step": 0.1
      },
      {
        "name": "particleColor",
        "label": "Particle Color",
        "type": "color",
        "group": "particles"
      },
      {
        "name": "mouseInteraction",
        "label": "Mouse Interaction",
        "type": "toggle",
        "group": "motion"
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "min": 0.2,
        "max": 3,
        "step": 0.1
      },
      {
        "name": "intensity",
        "label": "Intensity",
        "type": "range",
        "group": "motion",
        "min": 0.2,
        "max": 3,
        "step": 0.1
      },
      {
        "name": "morphDuration",
        "label": "Morph Duration",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0.2,
        "max": 5,
        "step": 0.05,
        "visibleWhen": {
          "name": "mouseInteraction",
          "eq": true
        }
      },
      {
        "name": "demorphIntensity",
        "label": "Demorph Intensity",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 4,
        "step": 0.05,
        "visibleWhen": {
          "name": "mouseInteraction",
          "eq": true
        }
      },
      {
        "name": "rotationSpeed",
        "label": "Rotation Speed",
        "type": "range",
        "group": "donut",
        "groupTitle": "Donut",
        "copyable": true,
        "min": 0,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "tiltX",
        "label": "Tilt X",
        "type": "range",
        "group": "donut",
        "groupTitle": "Donut",
        "copyable": true,
        "min": -180,
        "max": 180,
        "step": 1
      },
      {
        "name": "tiltY",
        "label": "Tilt Y",
        "type": "range",
        "group": "donut",
        "groupTitle": "Donut",
        "copyable": true,
        "min": -180,
        "max": 180,
        "step": 1
      }
    ]
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/donut-particles/index.tsx"
    }
  ],
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ]
}
