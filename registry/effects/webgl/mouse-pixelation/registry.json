{
  "name": "mouse-pixelation",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-22",
      "summary": "added reduced-motion",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Mouse Pixelation",
  "description": "Three R3F WebGL mouse-reactive pixelation effects behind a version-switcher header. V1: GLSL pixel-circle shader with animated orbiting circles and GSAP scroll pin. V2: image texture with velocity-driven block displacement. V3: extruded pixel trail grid paired with a deforming bloom-lit cube that auto-cycles neon colors.",
  "category": "webgl",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/postprocessing",
    "gsap",
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/mouse-pixelation",
  "tier": "pro",
  "main": "index.tsx",
  "exportName": "MousePixelation",
  "exportKind": "default",
  "importPath": "@/components/effects/mouse-pixelation",
  "target": "src/components/effects/mouse-pixelation",
  "props": [
    {
      "name": "v1NumberOfGrids",
      "type": "number",
      "default": 35,
      "description": "V1 · Pixel Circles: number of grid cells across the effect."
    },
    {
      "name": "v1Lerp",
      "type": "number",
      "default": 0.1,
      "description": "V1 · Pixel Circles: smoothing of the mouse-following motion."
    },
    {
      "name": "v1BackgroundColor",
      "type": "string",
      "default": "#000000",
      "description": "V1 · Pixel Circles: canvas background color."
    },
    {
      "name": "v2NumberOfGrids",
      "type": "number",
      "default": 35,
      "description": "V2 · Pixel Shift: number of grid cells across the effect."
    },
    {
      "name": "v2Lerp",
      "type": "number",
      "default": 0.1,
      "description": "V2 · Pixel Shift: smoothing of the mouse-following motion."
    },
    {
      "name": "v3NumberOfGrids",
      "type": "number",
      "default": 35,
      "description": "V3 · Pixel Cube: number of grid cells across the effect."
    },
    {
      "name": "v3Lerp",
      "type": "number",
      "default": 0.1,
      "description": "V3 · Pixel Cube: smoothing of the mouse-following motion."
    },
    {
      "name": "v3CubeSize",
      "type": "number",
      "default": 1,
      "description": "V3 · Pixel Cube: scale of the cube."
    },
    {
      "name": "v3GridEmbossing",
      "type": "number",
      "default": 1,
      "description": "V3 · Pixel Cube: depth of the extruded grid."
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "v1",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "v1NumberOfGrids",
        "label": "Number of Grids",
        "type": "range",
        "group": "v1",
        "min": 8,
        "max": 90,
        "step": 1,
        "groupTitle": "V1 · Pixel Circles"
      },
      {
        "name": "v1Lerp",
        "label": "Lerp",
        "type": "range",
        "group": "v1",
        "min": 0.01,
        "max": 0.6,
        "step": 0.01,
        "groupTitle": "V1 · Pixel Circles"
      },
      {
        "name": "v1BackgroundColor",
        "label": "Background",
        "type": "color",
        "group": "v1",
        "groupTitle": "V1 · Pixel Circles"
      },
      {
        "name": "v2NumberOfGrids",
        "label": "Number of Grids",
        "type": "range",
        "group": "v2",
        "min": 8,
        "max": 90,
        "step": 1,
        "groupTitle": "V2 · Pixel Shift"
      },
      {
        "name": "v2Lerp",
        "label": "Lerp",
        "type": "range",
        "group": "v2",
        "min": 0.01,
        "max": 0.6,
        "step": 0.01,
        "groupTitle": "V2 · Pixel Shift"
      },
      {
        "name": "v3NumberOfGrids",
        "label": "Number of Grids",
        "type": "range",
        "group": "v3",
        "min": 8,
        "max": 90,
        "step": 1,
        "groupTitle": "V3 · Pixel Cube"
      },
      {
        "name": "v3Lerp",
        "label": "Lerp",
        "type": "range",
        "group": "v3",
        "min": 0.01,
        "max": 0.6,
        "step": 0.01,
        "groupTitle": "V3 · Pixel Cube"
      },
      {
        "name": "v3CubeSize",
        "label": "Cube Size",
        "type": "range",
        "group": "v3",
        "min": 0.5,
        "max": 2.2,
        "step": 0.05,
        "groupTitle": "V3 · Pixel Cube"
      },
      {
        "name": "v3GridEmbossing",
        "label": "Grid Embossing",
        "type": "range",
        "group": "v3",
        "min": 0,
        "max": 2,
        "step": 0.05,
        "groupTitle": "V3 · Pixel Cube"
      }
    ]
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/mouse-pixelation/index.tsx"
    }
  ]
}
