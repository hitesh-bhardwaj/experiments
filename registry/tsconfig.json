{
  "//": "Local-only config so registry/effects gets TS/TSX editor support and a tsc --noEmit check. Never read by the build/pack scripts and never shipped to consumers - each registry item is plain source with no build step of its own.",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "allowJs": true,
    "typeRoots": ["../vault-main/node_modules/@types"],
    "paths": {
      "react": ["../vault-main/node_modules/@types/react"],
      "react/jsx-runtime": ["../vault-main/node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["../vault-main/node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["../vault-main/node_modules/@types/react-dom"],
      "gsap": ["../vault-main/node_modules/gsap"],
      "gsap/*": ["../vault-main/node_modules/gsap/*"],
      "three": ["../vault-main/node_modules/@types/three"],
      "three/webgpu": ["../vault-main/node_modules/@types/three/build/three.webgpu.d.ts"],
      "three/tsl": ["../vault-main/node_modules/@types/three/build/three.tsl.d.ts"],
      "three/addons/*": ["../vault-main/node_modules/@types/three/examples/jsm/*"],
      "three/examples/jsm/*": ["../vault-main/node_modules/@types/three/examples/jsm/*"],
      "three/src/*": ["../vault-main/node_modules/@types/three/src/*"],
      "lenis/react": ["../vault-main/node_modules/lenis/dist/lenis-react.d.ts"],
      "@/*": ["../vault-main/src/*"],
      "*": ["../vault-main/node_modules/*"]
    }
  },
  "include": ["effects/**/*.ts", "effects/**/*.tsx", "../vault-main/node_modules/styled-jsx/global.d.ts"]
}
