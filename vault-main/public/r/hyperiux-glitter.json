{
  "name": "hyperiux-glitter",
  "type": "registry:component",
  "title": "Hyperiux Glitter Concept",
  "description": "Glittery particle logo concept with morphing model particles, cursor trail particles, and bloom postprocessing.",
  "dependencies": [
    "three",
    "@react-three/fiber",
    "@react-three/drei",
    "@react-three/postprocessing"
  ],
  "registryDependencies": [],
  "exportName": "HyperiuxGlitter",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "glitterColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Primary glitter color.",
      "suggested": true
    },
    {
      "name": "accentColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Secondary glitter highlight color.",
      "suggested": true
    },
    {
      "name": "speed",
      "type": "number",
      "default": 1,
      "description": "Particle animation speed.",
      "suggested": true
    },
    {
      "name": "mouseInfluence",
      "type": "number",
      "default": 1,
      "description": "Cursor influence on glitter movement.",
      "suggested": true
    },
    {
      "name": "rotationInfluence",
      "type": "number",
      "default": 1,
      "description": "Cursor influence on model rotation.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "glitterColor",
        "label": "Glitter Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "accentColor",
        "label": "Accent Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "speed",
        "label": "Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0.05,
        "max": 5,
        "step": 0.05
      },
      {
        "name": "mouseInfluence",
        "label": "Mouse Influence",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 4,
        "step": 0.05
      },
      {
        "name": "rotationInfluence",
        "label": "Rotation Influence",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0,
        "max": 4,
        "step": 0.05
      }
    ]
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/hyperiux-glitter/index.tsx"
    },
    {
      "path": "MorphingParticleModelNew.tsx",
      "type": "registry:component",
      "target": "src/components/effects/hyperiux-glitter/MorphingParticleModelNew.tsx"
    },
    {
      "path": "MouseTrailParticles.tsx",
      "type": "registry:component",
      "target": "src/components/effects/hyperiux-glitter/MouseTrailParticles.tsx"
    },
    {
      "path": "createSuspendedRaf.ts",
      "type": "registry:component",
      "target": "src/components/effects/hyperiux-glitter/createSuspendedRaf.ts"
    }
  ]
}