{
  "name": "scramble-text",
  "type": "registry:component",
  "title": "Scramble Text",
  "description": "Hacker-style text scramble effect that reveals text character by character on scroll",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "ScrambleText",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-31",
      "summary": "Added configurable text size, color, duration, stagger, and character-set controls.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "speed",
      "type": "number",
      "default": 0.6,
      "description": "Scramble character cycling speed.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "charType",
      "type": "string",
      "default": "uppercase",
      "description": "Character set used while scrambling.",
      "remixer": {
        "control": "select",
        "group": "motion",
        "groupTitle": "Motion",
        "options": [
          {
            "value": "uppercase",
            "label": "Uppercase"
          },
          {
            "value": "upperAndLowerCase",
            "label": "Mixed"
          },
          {
            "value": "0123456789",
            "label": "Numbers"
          }
        ]
      }
    },
    {
      "name": "textColor",
      "type": "string",
      "default": "#111111",
      "description": "Text color.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "align",
      "type": "string",
      "default": "left",
      "description": "Text alignment.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.7,
      "description": "Scramble reveal duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.04,
      "description": "Delay between scrambled characters.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.2,
        "step": 0.005
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/scramble-text/index.tsx"
    }
  ]
}