{
  "name": "svg-pixel-reveal",
  "type": "registry:component",
  "title": "SVG Pixel Reveal",
  "description": "Scroll-driven image that transitions from pixelated to crisp using an SVG filter and GSAP ScrollTrigger",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "SVGPixelReveal",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-28",
      "summary": "Added reduced motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-09",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "intensity",
      "type": "number",
      "default": 22,
      "description": "Starting pixelation intensity before the reveal sharpens the image.",
      "remixer": {
        "control": "range",
        "group": "filter",
        "groupTitle": "Filter",
        "min": 2,
        "max": 80,
        "step": 1
      }
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": true,
      "description": "Tie the reveal to scroll position. When off, the reveal plays once when the image enters the viewport.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion"
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 1.5,
      "description": "Reveal duration in seconds when scrub is off.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.2,
        "max": 5,
        "step": 0.1,
        "visibleWhen": {
          "name": "scrub",
          "eq": false
        }
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "filter",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/svg-pixel-reveal/index.tsx"
    }
  ]
}