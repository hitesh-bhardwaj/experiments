{
  "name": "glitchy-text",
  "type": "registry:component",
  "title": "Glitchy Text",
  "description": "GSAP SplitText effect that stagger-animates four overlapping char layers - two white and two yellow - out and in at slightly different delays, creating a chromatic glitch swap. Plays on mount and replays on button click.",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "exportName": "GlitchyText",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-30",
      "summary": "Added reduced motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "baseTextColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Base text layer color.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "glitchColor",
      "type": "string",
      "default": "#eab308",
      "description": "Accent color for the glitch layers and replay button.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.025,
      "description": "Delay between consecutive characters in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.15,
        "step": 0.005
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.6,
      "description": "Duration of each character's slide in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "ease",
      "type": "string",
      "default": "power2.inOut",
      "description": "GSAP ease for the slide.",
      "remixer": {
        "control": "select",
        "group": "motion",
        "groupTitle": "Motion",
        "options": [
          {
            "value": "none",
            "label": "none (linear)"
          },
          {
            "value": "power1.in",
            "label": "power1.in"
          },
          {
            "value": "power1.out",
            "label": "power1.out"
          },
          {
            "value": "power1.inOut",
            "label": "power1.inOut"
          },
          {
            "value": "power2.in",
            "label": "power2.in"
          },
          {
            "value": "power2.out",
            "label": "power2.out"
          },
          {
            "value": "power2.inOut",
            "label": "power2.inOut"
          },
          {
            "value": "power3.in",
            "label": "power3.in"
          },
          {
            "value": "power3.out",
            "label": "power3.out"
          },
          {
            "value": "power3.inOut",
            "label": "power3.inOut"
          },
          {
            "value": "power4.in",
            "label": "power4.in"
          },
          {
            "value": "power4.out",
            "label": "power4.out"
          },
          {
            "value": "power4.inOut",
            "label": "power4.inOut"
          },
          {
            "value": "expo.in",
            "label": "expo.in"
          },
          {
            "value": "expo.out",
            "label": "expo.out"
          },
          {
            "value": "expo.inOut",
            "label": "expo.inOut"
          },
          {
            "value": "sine.in",
            "label": "sine.in"
          },
          {
            "value": "sine.out",
            "label": "sine.out"
          },
          {
            "value": "sine.inOut",
            "label": "sine.inOut"
          },
          {
            "value": "circ.in",
            "label": "circ.in"
          },
          {
            "value": "circ.out",
            "label": "circ.out"
          },
          {
            "value": "circ.inOut",
            "label": "circ.inOut"
          },
          {
            "value": "back.in",
            "label": "back.in"
          },
          {
            "value": "back.out",
            "label": "back.out"
          },
          {
            "value": "back.inOut",
            "label": "back.inOut"
          },
          {
            "value": "elastic.in",
            "label": "elastic.in"
          },
          {
            "value": "elastic.out",
            "label": "elastic.out"
          },
          {
            "value": "elastic.inOut",
            "label": "elastic.inOut"
          },
          {
            "value": "bounce.in",
            "label": "bounce.in"
          },
          {
            "value": "bounce.out",
            "label": "bounce.out"
          },
          {
            "value": "bounce.inOut",
            "label": "bounce.inOut"
          }
        ]
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "colors",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/glitchy-text/index.tsx"
    }
  ]
}