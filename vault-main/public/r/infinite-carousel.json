{
  "name": "infinite-carousel",
  "type": "registry:component",
  "title": "Infinite Carousel",
  "description": "Infinitely looping card carousel with drag, snap, inertial easing, and an optional swipe tilt.",
  "dependencies": [
    "gsap",
    "lucide-react"
  ],
  "registryDependencies": [],
  "exportName": "InfiniteCarousel",
  "exportKind": "default",
  "tier": "pro",
  "version": "1.0.2",
  "changelog": [
    {
      "version": "1.0.2",
      "date": "2026-09-22",
      "summary": "Changed slider logic and made it smoother.",
      "breaking": false
    },
    {
      "version": "1.0.1",
      "date": "2026-07-28",
      "summary": "Added reduced-motion support and configurable carousel controls.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "infinite",
      "type": "boolean",
      "default": true,
      "description": "Loops the carousel endlessly instead of stopping at the last card.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "snap",
      "type": "boolean",
      "default": true,
      "description": "Settles the track on the nearest card after a drag or scroll.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "draggable",
      "type": "boolean",
      "default": true,
      "description": "Allows dragging the carousel with pointer and touch input.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "showNav",
      "type": "boolean",
      "default": true,
      "description": "Shows or hides the previous and next arrow buttons.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "autoPlay",
      "type": "boolean",
      "default": false,
      "description": "Automatically advances the carousel one card at a time.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "autoPlayInterval",
      "type": "number",
      "default": 3000,
      "description": "Milliseconds between automatic slide advances.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 1000,
        "max": 8000,
        "step": 100
      }
    },
    {
      "name": "tiltOnScroll",
      "type": "boolean",
      "default": false,
      "description": "Leans the cards into a fast swipe, then springs them back to level.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion"
      }
    },
    {
      "name": "tiltStrength",
      "type": "number",
      "default": 4.2,
      "description": "How far the cards lean when tilt on scroll is enabled.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 10,
        "step": 0.1
      }
    },
    {
      "name": "lerpFactor",
      "type": "number",
      "default": 0.12,
      "description": "Easing factor for the track - lower glides longer, higher snaps tighter.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.02,
        "max": 0.6,
        "step": 0.01
      }
    },
    {
      "name": "dragSensitivity",
      "type": "number",
      "default": 0.005,
      "description": "How far the track moves per pixel of drag.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.001,
        "max": 0.02,
        "step": 0.001
      }
    },
    {
      "name": "snapStrength",
      "type": "number",
      "default": 0.1,
      "description": "How firmly the track is pulled towards the nearest card.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.02,
        "max": 0.5,
        "step": 0.01
      }
    },
    {
      "name": "cardWidth",
      "type": "number",
      "default": 33.8,
      "description": "Desktop card width in viewport width units. The default shows 2.8 cards at a time.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 14,
        "max": 50,
        "step": 0.5
      }
    },
    {
      "name": "cardHeight",
      "type": "number",
      "default": 60,
      "description": "Card height in viewport height units.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 28,
        "max": 85,
        "step": 1
      }
    },
    {
      "name": "gap",
      "type": "number",
      "default": 1.9,
      "description": "Spacing between cards in viewport width units.",
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0,
        "max": 8,
        "step": 0.1
      }
    },
    {
      "name": "bgColor",
      "type": "color",
      "default": "#f4f0ea",
      "description": "Background color behind the carousel.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style",
        "enabled": false
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "behavior",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/infinite-carousel/index.tsx"
    }
  ]
}